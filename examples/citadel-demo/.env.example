# Copy to .env and fill in. Never commit the filled-in copy.

# Your OpenBox deployment
OPENBOX_PLATFORM_API_URL=https://api.openbox.ai
OPENBOX_DASHBOARD_URL=https://app.openbox.ai
OPENBOX_API_URL=https://api.openbox.ai

# Organisation API key — see SETUP.md step 1 for the permissions it needs.
# Used to create the agent and its controls, and by the demo UI to link each
# run to its session and to decide approvals.
OPENBOX_PLATFORM_API_KEY=

# The agent's own credentials, printed once when the agent is created.
OPENBOX_API_KEY=
OPENBOX_AGENT_DID=
OPENBOX_AGENT_PRIVATE_KEY=

# What to do if OpenBox is unreachable: fail_open runs ungoverned, fail_closed
# refuses. The demo ships fail_open so an outage does not look like a denial.
OPENBOX_ON_API_ERROR=fail_open

# The model the agent calls. Any OpenRouter model id works.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
